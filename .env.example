# Google SSO 설정
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application) 생성
#
# Authorized JavaScript origins에 아래를 등록해야 합니다:
#   http://localhost:5173         (vite dev / 프리뷰)
#   http://localhost:3000         (로컬 도커 프론트엔드)
#   https://neonstack.highmaru.com (실서버 프론트엔드)
#
# GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# PostgreSQL Database URL
# 형식: postgres://[user]:[password]@[host]:[port]/[database]
# 로컬 개발 기본값: postgres://neon:neon@localhost:5432/neon
# 실서버 배포 예시: postgres://myuser:mypassword@172.17.0.1:5432/neon (호스트 DB 연결 시)
DATABASE_URL=postgres://neon:neon@localhost:5432/neon
